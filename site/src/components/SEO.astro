---
// Spec: docs/specs/site.md. Ported from vladflaks.com's SEO.astro.
interface Props {
  title: string
  description: string
  jsonLd?: object | object[]
}

const { title, description, jsonLd } = Astro.props

const siteUrl = 'https://owox.github.io'
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const canonicalUrl = `${siteUrl}${base}/`
// 1200x630 PNG: LinkedIn, X, Slack, and WhatsApp don't render SVG as a share image. Generated by `npm run og:card`.
const absoluteImage = `${siteUrl}${base}/og.png`
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

{jsonLd && (
  /* `<script>` is a raw-text element: the parser ends it at the first `</script`, inside a JSON string or not.
     JSON.stringify escapes `"` and `\` but not `<`. `<` is the same character to any JSON reader. */
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
)}
