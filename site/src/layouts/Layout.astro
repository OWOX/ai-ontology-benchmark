---
// Spec: docs/specs/site.md
import { Font } from 'astro:assets'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch (e) {}
    </script>
    <Font cssVariable="--font-roboto" preload />
    <Font cssVariable="--font-space-mono" preload />
  </head>
  <body>
    <main>
      <div class="content">
        <slot />
      </div>
    </main>
    <footer>
      <p>Source: <a href="https://github.com/OWOX/ai-ontology-benchmark">github.com/OWOX/ai-ontology-benchmark</a></p>
      <div class="theme-switch" role="radiogroup" aria-label="Theme">
        <button type="button" role="radio" aria-checked="false" data-theme-choice="light" aria-label="Light theme" title="Light theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg></button>
        <button type="button" role="radio" aria-checked="false" data-theme-choice="dark" aria-label="Dark theme" title="Dark theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg></button>
        <button type="button" role="radio" aria-checked="true" data-theme-choice="system" aria-label="System theme" title="System theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg></button>
      </div>
      <script is:inline>
        (function () {
          var radios = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'))
          var stored = null
          try { stored = localStorage.getItem('theme') } catch (e) {}
          var current = stored === 'light' || stored === 'dark' ? stored : 'system'
          function apply(choice, focus) {
            current = choice
            if (choice === 'system') document.documentElement.removeAttribute('data-theme')
            else document.documentElement.dataset.theme = choice
            try { localStorage.setItem('theme', choice) } catch (e) {}
            radios.forEach(function (r) {
              var on = r.dataset.themeChoice === choice
              r.setAttribute('aria-checked', on ? 'true' : 'false')
              r.tabIndex = on ? 0 : -1
              if (on && focus) r.focus()
            })
          }
          radios.forEach(function (r, i) {
            r.addEventListener('click', function () { apply(r.dataset.themeChoice) })
            r.addEventListener('keydown', function (e) {
              var d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0
              if (e.key === 'Home' || e.key === 'End') { e.preventDefault(); apply(radios[e.key === 'Home' ? 0 : radios.length - 1].dataset.themeChoice, true); return }
              if (!d) return
              e.preventDefault()
              apply(radios[(i + d + radios.length) % radios.length].dataset.themeChoice, true)
            })
          })
          radios.forEach(function (r) {
            var on = r.dataset.themeChoice === current
            r.setAttribute('aria-checked', on ? 'true' : 'false')
            r.tabIndex = on ? 0 : -1
          })
        })()
      </script>
    </footer>
  </body>
</html>
